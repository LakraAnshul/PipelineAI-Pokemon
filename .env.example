# Pokémon Explorer needs no configuration to run.
#
# PokéAPI is public — no key, no auth header, no account. Copy this file to
# `.env` only if you need the one override below; otherwise skip it entirely,
# and leave the environment section of Vercel or Render empty.

# Where the API lives. Set this only to point at a mirror or a caching proxy.
# Read at build time (Vite inlines VITE_* variables), so changing it means
# rebuilding, not restarting. No trailing slash needed — one is trimmed anyway.
# VITE_POKEAPI_BASE_URL=https://pokeapi.co/api/v2
